{
  "name": "tradestack-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext ts,json --exec tsx src/server.ts",
    "build": "npm run prisma:generate && tsc",
    "start": "node dist/server.js",
    "typecheck": "npm run prisma:generate && tsc --noEmit && tsc --noEmit --module NodeNext --moduleResolution NodeNext --target ES2023 --strict --skipLibCheck prisma.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/adapter-pg": "~7.0.0",
    "@prisma/client": "~7.0.0",
    "@sendgrid/mail": "^8.1.6",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "stripe": "^22.6.2",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.1.14",
    "prisma": "~7.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
