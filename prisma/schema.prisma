generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id                  String  @id @default(uuid()) @db.Uuid
  userId              String  @unique @db.Uuid
  customerFirstName   String
  customerLastName    String
  email               String  @unique
  customerNationality String
  phoneNumber         String  @unique
  reglink             String?
  isActive            Boolean @default(true)

  consentAccepted   Boolean   @default(false)
  consentAcceptedAt DateTime?

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradingAccounts TradingAccount[]
  kycProfile      KycProfile?
  kycAgreement    KycAgreement?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KycAgreement {
  id         String @id @default(uuid()) @db.Uuid
  customerId String @unique @db.Uuid

  // Agreement used when customer signed
  documentVersion String

  // Location of generated signed PDF
  documentPath String

  // SHA-256 of final PDF
  documentHash String

  // Signing audit information
  signedAt  DateTime
  ipAddress String?
  userAgent String?

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum KycStatus {
  NOT_STARTED
  PROFILE_IN_PROGRESS
  PROFILE_COMPLETED
  IDENTITY_PENDING
  IDENTITY_IN_PROGRESS
  IDENTITY_VERIFIED
  IDENTITY_REJECTED
  SIGNATURE_PENDING
  COMPLETED
  APPROVED
  REJECTED
}

enum TradingPlatform {
  MT4
  MT5
}

enum TradingAccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

model TradingAccount {
  id         String @id @default(uuid()) @db.Uuid
  customerId String @db.Uuid

  // User-facing trading account number
  accountNumber String @unique

  // Display only for now.
  // No MT4/MT5 integration yet.
  platform TradingPlatform @default(MT5)

  // Base account currency
  currency String @default("USD")

  // Account balance
  balance Decimal @default(0) @db.Decimal(18, 2)

  status TradingAccountStatus @default(ACTIVE)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

model KycProfile {
  id         String @id @default(uuid()) @db.Uuid
  customerId String @unique @db.Uuid

  // Personal information
  dateOfBirth DateTime?
  gender      String?

  // Residential address
  countryOfResidence String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  state              String?
  postalCode         String?

  // Employment
  employmentStatus String?
  occupation       String?

  // KYC workflow
  status KycStatus @default(NOT_STARTED)

  // Sumsub - used in Step 2 later
  identityProvider  String?
  providerSessionId String? @unique

  // Progress timestamps
  profileCompletedAt DateTime?
  identityVerifiedAt DateTime?
  completedAt        DateTime?
  customer           Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Crypto {
  symbol        String               @id
  buyPrice      Decimal?             @db.Decimal(28, 10)
  spread        Decimal?             @db.Decimal(28, 10)
  price         Decimal              @db.Decimal(28, 10)
  changePercent Decimal              @db.Decimal(18, 8)
  high          Decimal              @db.Decimal(28, 10)
  low           Decimal              @db.Decimal(28, 10)
  updatedAt     DateTime             @updatedAt
  history       CryptoPriceHistory[]
}

model CryptoPriceHistory {
  id         String   @id @default(uuid()) @db.Uuid
  symbol     String
  price      Decimal  @db.Decimal(28, 10)
  recordedAt DateTime @default(now())
  crypto     Crypto   @relation(fields: [symbol], references: [symbol])

  @@index([symbol, recordedAt])
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

model Order {
  id                    String      @id @default(uuid()) @db.Uuid
  // Nullable only for orders created before account selection was required.
  tradingAccountId      String?
  amount                Int
  currency              String      @default("usd")
  status                OrderStatus @default(PENDING)
  stripeCheckoutId      String?     @unique
  stripePaymentIntentId String?     @unique
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

model User {
  id                String             @id @default(uuid()) @db.Uuid
  email             String             @unique
  passwordHash      String
  name              String?
  role              UserRole           @default(USER)
  isActive          Boolean            @default(true)
  sessions          UserSession[]
  passwordResetOtps PasswordResetOtp[]
  customer          Customer?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum UserRole {
  USER
  ADMIN
}

model PasswordResetOtp {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  otpHash    String
  expiresAt  DateTime
  verifiedAt DateTime?
  usedAt     DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PendingRegistration {
  id String @id @default(uuid())

  customerFirstName   String
  customerLastName    String
  email               String  @unique
  passwordHash        String
  customerNationality String
  phoneNumber         String
  reglink             String?

  consentAccepted   Boolean
  consentAcceptedAt DateTime

  otpHash      String
  otpExpiresAt DateTime
  otpAttempts  Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([otpExpiresAt])
}
